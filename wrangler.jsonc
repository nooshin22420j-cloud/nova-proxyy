{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxyy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c970dbe3-7fa9-47b7-bca4-0dd1be4b2807","database_name": "nova-proxyy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2878369afb334ec88d2cb22862099684" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
